# Supabase Configuration
# Provide your Supabase project credentials below.
# When empty, the platform runs in high-fidelity Demo / Local Mode automatically.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

